# Build-time config for the SovereignAI frontend.
# Same-origin default: leave empty and serve dist/ from the same host that
# proxies /api/* and /ws/* to the backend (see deploy/nginx-sovereign-ai.conf).
# Remote backend: set the public backend origin, then `npm run build`.
VITE_API_BASE_URL=
# Optional WebSocket override (else derived from VITE_API_BASE_URL).
VITE_WS_BASE_URL=
# Set to 0 at build time to strip one-click demo accounts AND their test
# passwords from the production bundle:  VITE_DEMO_CREDS=0 npm run build
# (Server flag SOV_DEMO_LOGIN=0 additionally hides them at runtime.)
VITE_DEMO_CREDS=1
