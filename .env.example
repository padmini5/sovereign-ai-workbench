# SovereignAI Workbench — environment template for Docker AND native runs.
# Copy to .env (compose) or /etc/sovereign-ai-workbench.env (native):
#   cp .env.example .env
# NEVER commit real secrets to git. Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"

# --- REQUIRED in production ---
SOV_ENV=production
SOV_JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
SOV_CORS_ORIGINS=https://workbench.example.com
SOV_DEMO_LOGIN=1
# SIH public demo: 1 shows the designated demo accounts on the login page
# (demo-only credentials; server-side RBAC stays fully active). For a
# locked-down deployment, set SOV_DEMO_LOGIN=0 to hide them.
# Interactive API docs stay OFF in production unless explicitly enabled:
# SOV_API_DOCS=1
# SIH demo frontend builds keep demo test-passwords visible in the bundle:
# (frontend/Dockerfile defaults VITE_DEMO_CREDS=1; pass --build-arg
# VITE_DEMO_CREDS=0 for a locked-down build that strips them)
# VITE_DEMO_CREDS=1

# --- Docker: PostgreSQL (compose reads these; keep placeholders here) ---
POSTGRES_USER=sov
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=sov
# Compose builds this for you; native runs may set it manually:
# DATABASE_URL=postgresql://sov:change-me@db:5432/sov

# --- Docker: Ollama (optional profile `local-ai`; external daemon also fine) ---
# SOV_OLLAMA_URL=http://ollama:11434

# --- Network (systemd ExecStart also reads SOV_HOST/SOV_PORT) ---
SOV_HOST=0.0.0.0
SOV_PORT=8000

# --- Auth ---
SOV_JWT_EXPIRY_HOURS=8
# SOV_ROLES_FILE=/opt/sovereign-ai-workbench/roles.yaml
# Organization email domains enforced server-side at login (comma-separated).
# Plain non-email usernames are unaffected (legacy demo compatibility).
# ALLOWED_EMAIL_DOMAINS=company.com,example.org

# --- Attendance device gateway (fail-closed: empty = all device calls denied) ---
# SOV_DEVICE_KEYS=dev-device-key-1,dev-device-key-2

# --- Storage (defaults keep data inside <repo>/backend/; set for prod isolation) ---
# SOV_DATA_DIR=/var/lib/sov-workbench
# SOV_AUDIT_DB=/var/lib/sov-workbench/audit.db
# SOV_KB_STORE=/var/lib/sov-workbench/kb_store.json
# SOV_CHROMA_DIR=/var/lib/sov-workbench/chroma_db
# SOV_OUTPUTS_DIR=/var/lib/sov-workbench/outputs
# SOV_KEY_REGISTRY=/var/lib/sov-workbench/key_registry.json

# --- Optional providers (app starts fine without them) ---
# SOV_OLLAMA_URL=http://127.0.0.1:11434
# SOV_MODEL_TIER=large
# SOV_PQC=0
# SOV_HYBRID=0

# --- Phase 2: AI assistant ---
# SOV_AI_PROVIDER=auto        # auto | mock | mock-fail | ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b   # locally installed model; /api/v1/ai/status reports presence (never assumed)
# SOV_CHAT_DB=/var/lib/sov-workbench/chat.db
# DATABASE_URL=postgresql://sov:secret@db:5432/sov  # needs `pip install psycopg[binary]`; same schema

# --- Phase 3: documents ---
# SOV_MAX_UPLOAD_MB=10
# SOV_UPLOADS_DIR=/var/lib/sov-workbench/uploads
# SOV_DOCS_DB=/var/lib/sov-workbench/docs.db
# SOV_VISION_PROVIDER=local   # local Pillow validation/preview + on-prem OCR when present
# SOV_IMAGE_KEY=              # optional Fernet key for image encryption at rest.
                              # Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
                              # NEVER commit. Without it, images rest with restricted file permissions.

# --- Phase 4: RAG document intelligence ---
# SOV_EMBED_PROVIDER=mock     # mock | hash (local on-prem) | ollama | fail
# SOV_EMBED_MODEL=nomic-embed-text   # for ollama neural embeddings
# SOV_RAG_TOP_K=4
# SOV_VECTORS_DB=/var/lib/sov-workbench/vectors.db
# SOV_VECTOR_BACKEND=         # set to 'fail' only for failure-path tests

# --- Step 19: Indian multilingual support ---
# SOV_TRANSLATE_PROVIDER=mock   # mock | local (on-prem engine) | unavailable
# SOV_TRANSLATE_REMOTE_URL=     # unset = remote translation DISABLED (on-prem default)
# SOV_TRANSLATE_ALLOW_REMOTE=0  # must be 1 AND url set to allow remote calls

# --- Step 20: voice I/O ---
# SOV_STT_PROVIDER=mock        # mock | local (on-prem engine) | unavailable
# SOV_TTS_PROVIDER=mock        # mock | local (on-prem engine) | unavailable
# Local STT uses the offline vosk model below when SOV_STT_PROVIDER=local.
# SOV_VOSK_MODEL_DIR=backend/models/vosk-small-en
# Local TTS uses OS voices (Windows SAPI) via pyttsx3 when SOV_TTS_PROVIDER=local.
# SOV_MAX_AUDIO_MB=5
# SOV_STT_REMOTE_URL=          # unset = remote STT DISABLED (on-prem default)
# SOV_STT_ALLOW_REMOTE=0
# SOV_TTS_REMOTE_URL=          # unset = remote TTS DISABLED (on-prem default)
# SOV_TTS_ALLOW_REMOTE=0

# --- Step 21: agentic workflows ---
# SOV_AGENTS_DB=/var/lib/sov-workbench/agents.db

# --- Step 23: rate limits (requests/minute; generous defaults) ---
# SOV_RATE_LOGIN=60 SOV_RATE_CHAT=120 SOV_RATE_UPLOAD=60 SOV_RATE_ANALYZE=120
# SOV_RATE_AGENT_RUN=60 SOV_RATE_VOICE=120 SOV_RATE_ADMIN_CONFIG=60
